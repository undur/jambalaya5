<?xml version="1.0" encoding="utf-8"?>
<data-map xmlns="http://cayenne.apache.org/schema/12/modelMap"
	 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	 xsi:schemaLocation="http://cayenne.apache.org/schema/12/modelMap https://cayenne.apache.org/schema/12/modelMap.xsd"
	 project-version="12">
	<property name="defaultPackage" value="jambalaya.model"/>
	<db-entity name="artist">
		<db-attribute name="creation_date" type="TIMESTAMP"/>
		<db-attribute name="id" type="INTEGER" isPrimaryKey="true" isMandatory="true"/>
		<db-attribute name="modification_date" type="TIMESTAMP"/>
		<db-attribute name="name" type="LONGVARCHAR"/>
		<db-attribute name="unique_id" type="LONGVARCHAR"/>
	</db-entity>
	<db-entity name="painting">
		<db-attribute name="artist_id" type="INTEGER"/>
		<db-attribute name="creation_date" type="TIMESTAMP"/>
		<db-attribute name="id" type="INTEGER" isPrimaryKey="true" isMandatory="true"/>
		<db-attribute name="modification_date" type="TIMESTAMP"/>
		<db-attribute name="name" type="LONGVARCHAR"/>
		<db-attribute name="unique_id" type="LONGVARCHAR"/>
	</db-entity>
	<obj-entity name="Artist" className="jambalaya.model.Artist" dbEntityName="artist">
		<obj-attribute name="creationDate" type="java.time.LocalDateTime" db-attribute-path="creation_date"/>
		<obj-attribute name="modificationDate" type="java.time.LocalDateTime" db-attribute-path="modification_date"/>
		<obj-attribute name="name" type="java.lang.String" db-attribute-path="name"/>
		<obj-attribute name="uniqueID" type="java.lang.String" db-attribute-path="unique_id"/>
	</obj-entity>
	<obj-entity name="Painting" className="jambalaya.model.Painting" dbEntityName="painting">
		<obj-attribute name="creationDate" type="java.time.LocalDateTime" db-attribute-path="creation_date"/>
		<obj-attribute name="modificationDate" type="java.time.LocalDateTime" db-attribute-path="modification_date"/>
		<obj-attribute name="name" type="java.lang.String" db-attribute-path="name"/>
		<obj-attribute name="uniqueID" type="java.lang.String" db-attribute-path="unique_id"/>
	</obj-entity>
	<db-relationship name="paintings" source="artist" target="painting" toMany="true">
		<db-attribute-pair source="id" target="artist_id"/>
	</db-relationship>
	<db-relationship name="artist" source="painting" target="artist">
		<db-attribute-pair source="artist_id" target="id"/>
	</db-relationship>
	<obj-relationship name="paintings" source="Artist" target="Painting" deleteRule="Deny" db-relationship-path="paintings"/>
	<obj-relationship name="artist" source="Painting" target="Artist" deleteRule="Nullify" db-relationship-path="artist"/>
</data-map>
